<Window x:Class="DynamicIsland.Shell.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:media="clr-namespace:DynamicIsland.Providers.Media"
        xmlns:views="clr-namespace:DynamicIsland.Views"
        xmlns:claude="clr-namespace:DynamicIsland.Providers.Claude"
        xmlns:timers="clr-namespace:DynamicIsland.Providers.Timers"
        xmlns:levels="clr-namespace:DynamicIsland.Providers.SystemLevels"
        xmlns:stats="clr-namespace:DynamicIsland.Providers.SystemStats"
        xmlns:notifications="clr-namespace:DynamicIsland.Providers.Notifications"
        Title="Dynamic Island"
        Width="620" Height="170"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:VerticalTemplateSelector x:Key="VerticalSelector"/>
        <!-- One DataTemplate per activity type; new providers add theirs here. -->
        <DataTemplate DataType="{x:Type media:MediaActivity}">
            <views:MediaView IsExpanded="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type notifications:NotificationActivity}">
            <views:NotificationView IsExpanded="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type claude:ClaudeActivity}">
            <views:ClaudeView IsExpanded="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type timers:TimerActivity}">
            <views:TimerView IsExpanded="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type timers:ReminderActivity}">
            <views:ReminderView IsExpanded="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type stats:SystemStatsActivity}">
            <views:SystemStatsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type levels:LevelActivity}">
            <views:LevelView/>
        </DataTemplate>
    </Window.Resources>

    <!-- Transparent window area is click-through; only the pills take input.
         The star columns keep the main pill centered while the small islands hug its sides. -->
    <Grid x:Name="Root" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <views:SatelliteView x:Name="LeftIsland" DataContext="{Binding Left}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,8,0"
                             Visibility="{Binding DataContext.IsLeftVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

        <Border x:Name="Pill" Grid.Column="1" Background="{DynamicResource IslandBackground}" HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="230" Height="38" CornerRadius="0,0,15,15" ClipToBounds="True"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
                PreviewMouseLeftButtonDown="Pill_PreviewMouseLeftButtonDown" PreviewMouseMove="Pill_PreviewMouseMove"
                PreviewMouseLeftButtonUp="Pill_PreviewMouseLeftButtonUp" LostMouseCapture="Pill_LostMouseCapture">
            <ContentControl Content="{Binding Current}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <!-- Docked to a side edge and collapsed: the stacked compact layouts. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsVertical}" Value="True"/>
                                    <Condition Binding="{Binding IsExpanded}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="ContentTemplateSelector" Value="{StaticResource VerticalSelector}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Border>

        <views:SatelliteView x:Name="RightIsland" Grid.Column="2" DataContext="{Binding Right}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0"
                             Visibility="{Binding DataContext.IsRightVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>
