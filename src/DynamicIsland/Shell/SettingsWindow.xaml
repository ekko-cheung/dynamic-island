<Window x:Class="DynamicIsland.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="500" Height="760" MinWidth="420" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3" FontSize="13"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,18" Text="所有修改立即生效并自动保存"/>

            <!-- 显示位置 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="显示位置"/>
                    <StackPanel x:Name="PlacementPanel"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="小岛只显示紧凑形态,通知在小岛上只显示应用图标;带关闭按钮的常驻通知始终在主岛。"/>
                </StackPanel>
            </Border>

            <!-- 系统状态 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="系统状态"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="空闲时显示"/>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="主岛没有其他内容时,显示 CPU、内存、上传和下载速度。开启后灵动岛会一直显示;关闭则空闲时隐藏。"/>
                        </StackPanel>
                        <CheckBox x:Name="StatsIdleBox" Grid.Column="1" Style="{StaticResource Switch}" Click="StatsBox_Click"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="主岛有内容时在小岛显示"/>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="左小岛显示内存占用率,右小岛显示网速;优先级最低,会让位给其他小岛内容。"/>
                        </StackPanel>
                        <CheckBox x:Name="StatsBusyBox" Grid.Column="1" Style="{StaticResource Switch}" Click="StatsBox_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="外观"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="毛玻璃效果"/>
                            <TextBlock Style="{StaticResource Hint}" Text="模糊灵动岛背后的内容;关闭时为纯黑"/>
                        </StackPanel>
                        <CheckBox x:Name="GlassBox" Grid.Column="1" Style="{StaticResource Switch}" Click="GlassBox_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 显示器 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="显示器"/>
                    <Border Background="#EEEEEE" CornerRadius="8" Padding="2" HorizontalAlignment="Left">
                        <WrapPanel x:Name="MonitorPanel"/>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="灵动岛显示在哪块屏幕的顶部居中。选中的屏幕未连接时,临时回到主显示器。"/>
                </StackPanel>
            </Border>

            <!-- 位置 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="位置"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="水平偏移" VerticalAlignment="Center"/>
                        <Slider x:Name="OffsetXSlider" Grid.Column="1" Minimum="-3000" Maximum="3000" SmallChange="1" LargeChange="20"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Offset_Changed"/>
                        <TextBlock x:Name="OffsetXText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="距顶部" VerticalAlignment="Center"/>
                        <Slider x:Name="OffsetYSlider" Grid.Column="1" Minimum="0" Maximum="2000" SmallChange="1" LargeChange="10"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Offset_Changed"/>
                        <TextBlock x:Name="OffsetYText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="拖动时吸附边缘"/>
                            <TextBlock Style="{StaticResource Hint}" Text="直接用鼠标拖动灵动岛即可移动;靠近屏幕边缘或中线时自动吸附"/>
                        </StackPanel>
                        <CheckBox x:Name="SnapBox" Grid.Column="1" Style="{StaticResource Switch}" Click="SnapBox_Click"/>
                    </Grid>
                    <Button Content="恢复默认(居中贴顶)" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,3" Click="OffsetReset_Click"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="单位为像素。距顶部为 0 时是刘海样式;大于 0 时变为悬浮胶囊。位置始终限制在所选屏幕内。"/>
                </StackPanel>
            </Border>

            <!-- Claude Code -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Claude Code 集成"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock x:Name="ClaudeStatus" Text="正在检查…"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="在 ~/.claude/settings.json 里添加上报状态的 hooks。只增删灵动岛自己的条目,其他配置原样保留,改动前会备份为 settings.json.bak。"/>
                        </StackPanel>
                        <Button x:Name="ClaudeButton" Grid.Column="1" Style="{StaticResource PillButton}" VerticalAlignment="Top"
                                Click="ClaudeButton_Click" IsEnabled="False"/>
                    </Grid>
                    <TextBlock x:Name="ClaudeMessage" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 本地接口 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="本地接口"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="端口"/>
                            <TextBlock Style="{StaticResource Hint}" Text="填 0 关闭;修改后需重启程序生效"/>
                        </StackPanel>
                        <TextBox x:Name="PortBox" Grid.Column="1" Width="90" VerticalAlignment="Center"
                                 HorizontalContentAlignment="Center" LostFocus="PortBox_LostFocus"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 启动 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="启动"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开机自启"/>
                            <TextBlock x:Name="AutostartHint" Style="{StaticResource Hint}" Text="仅在以 MSIX 方式安装/注册时可用"/>
                        </StackPanel>
                        <CheckBox x:Name="AutostartBox" Grid.Column="1" Style="{StaticResource Switch}" Click="AutostartBox_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
