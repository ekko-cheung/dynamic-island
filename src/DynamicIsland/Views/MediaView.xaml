<UserControl x:Class="DynamicIsland.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DynamicIsland.Views">
    <UserControl.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Compact: small cover + playing indicator -->
        <Grid Margin="10,0" VerticalAlignment="Center" Height="38"
              Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=views:MediaView}, Converter={x:Static views:InvertedBoolToVisibility.Instance}}">
            <Border Width="26" Height="26" CornerRadius="13" ClipToBounds="True" HorizontalAlignment="Left" Background="#222">
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="36,0,30,0"/>
            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="#FF30D158" FontSize="12"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Visibility="{Binding IsPlaying, Converter={x:Static views:BoolToVisibility.Instance}}"/>
        </Grid>

        <!-- Expanded: cover, title/artist, progress, controls -->
        <Grid Margin="16,14,16,16"
              Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=views:MediaView}, Converter={x:Static views:BoolToVisibility.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="64" Height="64" CornerRadius="12" ClipToBounds="True" Background="#222" VerticalAlignment="Top">
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Artist}" Foreground="#AAFFFFFF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" Margin="0,8,0,0"
                             Foreground="White" Background="#44FFFFFF" BorderThickness="0"/>
                <Grid Margin="0,2,0,0">
                    <TextBlock Text="{Binding PositionText}" Foreground="#88FFFFFF" FontSize="10"/>
                    <TextBlock Text="{Binding DurationText}" Foreground="#88FFFFFF" FontSize="10" HorizontalAlignment="Right"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}"/>
                    <Button Style="{StaticResource IconButton}" Command="{Binding TogglePlayPauseCommand}">
                        <TextBlock Text="{Binding IsPlaying, Converter={x:Static views:PlayPauseGlyph.Instance}}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
