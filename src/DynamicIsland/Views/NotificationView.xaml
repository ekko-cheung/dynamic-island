<UserControl x:Class="DynamicIsland.Views.NotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DynamicIsland.Views">
    <Grid>
        <!-- Compact: app icon + one-line title -->
        <Grid Margin="10,0" VerticalAlignment="Center" Height="38"
              Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=views:NotificationView}, Converter={x:Static views:InvertedBoolToVisibility.Instance}}">
            <Border Width="22" Height="22" CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Left" Background="#333">
                <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="30,0,0,0"/>
        </Grid>

        <!-- Expanded: app name, title, body -->
        <Grid Margin="16,14,16,16"
              Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=views:NotificationView}, Converter={x:Static views:BoolToVisibility.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10" ClipToBounds="True" Background="#333" VerticalAlignment="Top">
                <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="{Binding AppName}" Foreground="#88FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Body}" Foreground="#CCFFFFFF" FontSize="12" TextWrapping="Wrap"
                           MaxHeight="48" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                    Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0"
                    Foreground="White" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand"
                    Command="{Binding DismissCommand}" ToolTip="关闭"
                    Visibility="{Binding IsSticky, Converter={x:Static views:BoolToVisibility.Instance}}"/>
        </Grid>
    </Grid>
</UserControl>
