<UserControl x:Class="DynamicIsland.Views.LevelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,0" Height="38">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="36"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"
                   VerticalAlignment="Center"/>
        <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="5" Margin="6,0,10,0"
                     VerticalAlignment="Center" Foreground="White" Background="#44FFFFFF" BorderThickness="0"/>
        <TextBlock Grid.Column="2" Text="{Binding Percent}" Foreground="#CCFFFFFF" FontSize="12"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
