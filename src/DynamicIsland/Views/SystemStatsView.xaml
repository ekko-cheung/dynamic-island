<UserControl x:Class="DynamicIsland.Views.SystemStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DynamicIsland.Views">
    <UserControl.Resources>
        <Style x:Key="Speed" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Compact only. Order: CPU, memory, upload, download. The rings carry no text; hover shows the number. -->
    <Grid Margin="12,0" Height="38" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.6*"/>
            <ColumnDefinition Width="1.6*"/>
        </Grid.ColumnDefinitions>
        <views:RingGauge Width="22" Height="22" Value="{Binding CpuValue}" Brush="{Binding CpuValue, Converter={x:Static views:LoadBrush.Cpu}}"
                         ToolTip="{Binding CpuText, StringFormat=CPU {0}}"/>
        <views:RingGauge Grid.Column="1" Width="22" Height="22" Value="{Binding MemoryValue}"
                         Brush="{Binding MemoryValue, Converter={x:Static views:LoadBrush.Memory}}"
                         ToolTip="{Binding MemoryText, StringFormat=内存 {0}}"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="上传速度">
            <TextBlock Text="&#x2191;" Foreground="#FFFF9F0A" FontSize="12" Style="{StaticResource Speed}"/>
            <TextBlock Text="{Binding UploadText}" Style="{StaticResource Speed}" Margin="2,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="下载速度">
            <TextBlock Text="&#x2193;" Foreground="#FF30D158" FontSize="12" Style="{StaticResource Speed}"/>
            <TextBlock Text="{Binding DownloadText}" Style="{StaticResource Speed}" Margin="2,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
