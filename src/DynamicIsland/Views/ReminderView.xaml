<UserControl x:Class="DynamicIsland.Views.ReminderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DynamicIsland.Views">
    <UserControl.Resources>
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Compact: bell + text (the whole pill is the reminder, so make it easy to spot) -->
        <Grid Margin="14,0" Height="38"
              Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=views:ReminderView}, Converter={x:Static views:InvertedBoolToVisibility.Instance}}">
            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFFF9F0A"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Text}" Foreground="White" FontSize="12" Margin="26,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- Expanded: title, text, actions -->
        <Grid Margin="20,14,20,16"
              Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=views:ReminderView}, Converter={x:Static views:BoolToVisibility.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FFFF9F0A" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title}" Foreground="#FFFF9F0A" FontSize="12" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding Text}" Foreground="White" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource TextButton}" Content="5 分钟后再提醒" Command="{Binding SnoozeCommand}" Margin="0,0,8,0"
                        Visibility="{Binding CanSnooze, Converter={x:Static views:BoolToVisibility.Instance}}"/>
                <Button Style="{StaticResource TextButton}" Content="知道了" Command="{Binding DismissCommand}" Background="#FFFF9F0A" Foreground="Black"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
