<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DynamicIsland.Views">
    <!-- Compact layouts for when the island is docked to the left or right edge: the content is stacked top to bottom.
         Picked by VerticalTemplateSelector; the expanded card keeps its normal layout. -->

    <DataTemplate x:Key="Media">
        <StackPanel Margin="0,10" HorizontalAlignment="Center">
            <Border Width="30" Height="30" CornerRadius="15" ClipToBounds="True" Background="#222">
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
            </Border>
            <views:EqualizerBars BarBrush="#FF30D158" HorizontalAlignment="Center" Margin="0,8,0,0"
                                 Visibility="{Binding IsPlaying, Converter={x:Static views:BoolToVisibility.Instance}}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Notification">
        <Border Width="26" Height="26" Margin="0,12" CornerRadius="7" ClipToBounds="True" Background="#333" HorizontalAlignment="Center">
            <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Claude">
        <StackPanel Margin="0,12" HorizontalAlignment="Center">
            <Ellipse Width="9" Height="9" Fill="{Binding AccentBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding StateText}" Foreground="{Binding AccentBrush}" FontSize="11" Margin="0,6,0,0"
                       HorizontalAlignment="Center" ToolTip="{Binding Project}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Timer">
        <StackPanel Margin="0,12" HorizontalAlignment="Center" ToolTip="{Binding Label}">
            <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFFF9F0A" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding RemainingText}" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Reminder">
        <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FFFF9F0A" Margin="0,14"
                   HorizontalAlignment="Center" ToolTip="{Binding Text}"/>
    </DataTemplate>

    <DataTemplate x:Key="Level">
        <StackPanel Margin="0,12" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Percent}" Foreground="#CCFFFFFF" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Stats">
        <StackPanel Margin="0,12" HorizontalAlignment="Center">
            <views:RingGauge Width="22" Height="22" Value="{Binding CpuValue}"
                             Brush="{Binding CpuValue, Converter={x:Static views:LoadBrush.Cpu}}"
                             ToolTip="{Binding CpuText, StringFormat=CPU {0}}"/>
            <views:RingGauge Width="22" Height="22" Margin="0,8,0,0" Value="{Binding MemoryValue}"
                             Brush="{Binding MemoryValue, Converter={x:Static views:LoadBrush.Memory}}"
                             ToolTip="{Binding MemoryText, StringFormat=内存 {0}}"/>
            <TextBlock FontSize="10" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0" ToolTip="上传速度">
                <Run Text="&#x2191;" Foreground="#FFFF9F0A"/><Run Text="{Binding UploadText, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock FontSize="10" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0" ToolTip="下载速度">
                <Run Text="&#x2193;" Foreground="#FF30D158"/><Run Text="{Binding DownloadText, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
