<UserControl x:Class="DynamicIsland.Views.SatelliteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="clr-namespace:DynamicIsland.Providers.Media"
             xmlns:levels="clr-namespace:DynamicIsland.Providers.SystemLevels"
             xmlns:claude="clr-namespace:DynamicIsland.Providers.Claude"
             xmlns:privacy="clr-namespace:DynamicIsland.Providers.Privacy"
             xmlns:notifications="clr-namespace:DynamicIsland.Providers.Notifications">
    <!-- A small island: compact-only rendering of whichever activity is routed to it. -->
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type media:MediaActivity}">
            <Border Width="26" Height="26" Margin="6" CornerRadius="13" ClipToBounds="True" Background="#222">
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type notifications:NotificationActivity}">
            <Grid Width="22" Height="22" Margin="8">
                <Border CornerRadius="6" ClipToBounds="True" Background="#333">
                    <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border CornerRadius="6" ClipToBounds="True">
                    <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type levels:LevelActivity}">
            <StackPanel Orientation="Horizontal" Margin="12,0">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Percent}" Foreground="#CCFFFFFF" FontSize="12" Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type privacy:MicrophoneActivity}">
            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FFFF9F0A"
                       Margin="11,0" VerticalAlignment="Center" ToolTip="{Binding AppsText}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type privacy:CameraActivity}">
            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FF30D158"
                       Margin="11,0" VerticalAlignment="Center" ToolTip="{Binding AppsText}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type privacy:LocationActivity}">
            <TextBlock Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FF0A84FF"
                       Margin="11,0" VerticalAlignment="Center" ToolTip="{Binding AppsText}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type claude:ClaudeActivity}">
            <StackPanel Orientation="Horizontal" Margin="12,0">
                <Ellipse Width="8" Height="8" Fill="{Binding AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StateText}" Foreground="{Binding AccentBrush}" FontSize="12" Margin="7,0,0,0"
                           VerticalAlignment="Center" ToolTip="{Binding Project}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="Black" Height="38" MinWidth="38" CornerRadius="19" ClipToBounds="True">
        <ContentControl Content="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</UserControl>
