<UserControl x:Class="DynamicIsland.Views.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DynamicIsland.Views">
    <UserControl.Resources>
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Compact: clock glyph, label, remaining time -->
        <Grid Margin="14,0" Height="38"
              Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=views:TimerView}, Converter={x:Static views:InvertedBoolToVisibility.Instance}}">
            <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFFF9F0A"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Label}" Foreground="#AAFFFFFF" FontSize="12" Margin="26,0,70,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding RemainingText}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Expanded: big time, progress, controls -->
        <Grid Margin="20,14,20,16"
              Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=views:TimerView}, Converter={x:Static views:BoolToVisibility.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Foreground="#88FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis">
                <Run Text="倒计时"/><Run Text=" · "/><Run Text="{Binding Label, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Grid.Row="1" Text="{Binding RemainingText}" Foreground="White" FontSize="34" FontWeight="Light" Margin="0,2,0,0"/>
            <ProgressBar Grid.Row="1" Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" VerticalAlignment="Bottom"
                         Foreground="#FFFF9F0A" Background="#44FFFFFF" BorderThickness="0"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <Button Style="{StaticResource RoundButton}" Content="{Binding PauseGlyph}" Command="{Binding TogglePauseCommand}" ToolTip="暂停/继续"/>
                <Button Style="{StaticResource RoundButton}" Content="&#xE710;" Command="{Binding AddMinuteCommand}" Margin="12,0" ToolTip="加 1 分钟"/>
                <Button Style="{StaticResource RoundButton}" Content="&#xE711;" Command="{Binding CancelCommand}" ToolTip="取消"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
