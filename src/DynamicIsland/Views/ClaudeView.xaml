<UserControl x:Class="DynamicIsland.Views.ClaudeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DynamicIsland.Views"
             xmlns:claude="clr-namespace:DynamicIsland.Providers.Claude">
    <UserControl.Resources>
        <!-- A dot that pulses while Claude is running. -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Fill" Value="{Binding AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static claude:ClaudeState.Running}">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7"
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Compact: status dot, project, state -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="38"
                    Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=views:ClaudeView}, Converter={x:Static views:InvertedBoolToVisibility.Instance}}">
            <Ellipse Style="{StaticResource StatusDot}"/>
            <TextBlock Text="{Binding Project}" Foreground="White" FontSize="12" Margin="8,0,0,0" MaxWidth="100"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Text="·" Foreground="#88FFFFFF" FontSize="12" Margin="6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StateText}" Foreground="{Binding AccentBrush}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Expanded: icon, project, state, last message -->
        <Grid Margin="16,14,16,16"
              Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=views:ClaudeView}, Converter={x:Static views:BoolToVisibility.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="14" Background="#222" VerticalAlignment="Top">
                <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{Binding AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Foreground="#88FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis">
                    <Run Text="Claude Code ·"/> <Run Text="{Binding Project, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StateText}" Foreground="{Binding AccentBrush}" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding Message}" Foreground="#CCFFFFFF" FontSize="12" TextWrapping="Wrap"
                           MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
